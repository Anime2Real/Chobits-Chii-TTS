[Unit]
Description=Chobits-Chii TTS 门面 (GPT-SoVITS 反向代理, OpenAI 兼容垫片)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Github/Chobits-Chii-TTS
EnvironmentFile=/etc/chobits-chii-tts.env
ExecStart=/bin/bash /home/ubuntu/Github/Chobits-Chii-TTS/tools/start_tts_api.sh 9880
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
