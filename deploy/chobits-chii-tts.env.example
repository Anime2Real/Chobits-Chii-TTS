# TTS 门面配置模板。生产：cp 为 /etc/chobits-chii-tts.env 填真实值，chmod 600
# 密钥只存服务器 /etc，不进仓库
CHII_TTS_API_KEY=                    # 门面鉴权 key（垫片持有，openssl rand）
CHII_TTS_BIND=127.0.0.1              # 生产走 Caddy 反代时绑本机
# CHII_TTS_SSL_CERTFILE=             # 反代模式下不需要（TLS 由 Caddy 终结）
# CHII_TTS_SSL_KEYFILE=
# ---- 资源防护（默认值见下，可按需覆盖）----
# CHII_TTS_MAX_BODY_BYTES=26214400     # 请求体大小硬上限（/tts POST 与 /v1/audio/speech，超限 413）
# CHII_TTS_MAX_TEXT_CHARS=2000         # 合成文本长度硬上限（/tts 与 /v1/audio/speech）
# CHII_TTS_MAX_INFLIGHT=8              # 全局在途并发上限（超上限排队等待，不立即拒绝）
# CHII_TTS_QUEUE_TIMEOUT=30            # 并发排队等待超时（秒），超时仍无空位才返回 429
# CHII_TTS_REF_AUDIO_PREFIX=/data/     # /tts ref_audio 路径前缀约束（防容器内任意路径）
# CHII_TTS_RATE_LIMIT=60               # 每 IP 每分钟限流（/tts 与 /v1/audio/speech），0=关闭
# CHII_TTS_TEXT_LANG=            # 钉死合成语言（如 ja）；缺省按整请求文本判定主导语言
                                 # （假名≥汉字半数→ja，否则 zh；避免引擎 auto 逐片段
                                 # 检测导致中日混排忽中忽日）
# CHII_TTS_SPLIT_METHOD=cut1     # 引擎切分：cut1 凑四句一切（默认）；cut5 逐标点切
                                 # 会在逗号处产生断点，听感断续
# CHII_TTS_FRAGMENT_INTERVAL=0.05  # 片段间停顿秒数（引擎默认 0.3，偏大）
# CHII_TTS_ENGINE_URL=http://127.0.0.1:9882  # GPT-SoVITS 引擎地址
# CHII_TTS_DEEP_PROBE_TTL=30           # 引擎深探测（防"200 空流"变砖）结果缓存秒数
# CHII_TTS_DEEP_PROBE_TIMEOUT=20       # 引擎深探测超时秒数
# ---- 引擎批推理 ----
# CHII_TTS_BATCH_SIZE=5                # 引擎 batch_size 默认值（客户端未显式传时注入；
                                      # 仅非流式 aac/opus 路径生效，流式 wav 不受影响）
